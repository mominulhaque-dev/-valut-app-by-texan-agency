# Copy to .env and fill in. `shopify app dev` loads .env and supplies
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES itself;
# in production you set those four yourself.

# MongoDB connection string (Atlas or self-hosted). The database name in the
# URI is used unless DATABASE_NAME is set.
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/kindest_regards
# DATABASE_NAME=kindest_regards

# Origin of the Vault app. https only, no path. This is what gets engraved:
# it must be the final production domain before any QR goes to the engraver.
VAULT_BASE_URL=https://vault.example.com

# Products with this tag get a ring (one per unit).
RING_PRODUCT_TAG=has_vault_ring

# 32-byte key that encrypts Shopify tokens in the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different key per environment. Losing it means reinstalling the app.
TOKEN_ENCRYPTION_KEY=

# Optional. Enables POST /internal/sweep for hosts without a long-running
# process (call it from a scheduler with Authorization: Bearer <secret>).
# CRON_SECRET=

# Optional. Enables GET /api/rings/<ringId> for the Vault app's server.
# VAULT_API_KEY=
